{
  "_comment": "Mini \u2014 Raspberry Pi Zero 2 W, speaker and microphone, no screen. form_factor 'mini' is what makes the presenter SPEAK events instead of showing them. See hardware/mini-screenless/README.md.",
  "configured": false,
  "theme": "dark-river",
  "form_factor": "mini",
  "capabilities": {
    "audio": true,
    "display": false,
    "intercom": true,
    "home_assistant": true,
    "camera": false,
    "light_sensor": false,
    "presence_sensor": false
  },
  "hardware": {
    "screen": "none",
    "screen_width": 0,
    "screen_height": 0,
    "mic_array": "respeaker-2mic-hat",
    "speakers": "i2s-3w-mono",
    "platform": "raspberry-pi-zero-2w",
    "screen_shape": "none"
  },
  "audio": {
    "wake_word": "hey_jarvis",
    "volume": 80,
    "audio_device_index": -1,
    "wake_word_threshold": 0.55
