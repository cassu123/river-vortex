{
  "_comment": "River Vortex unit profile. Identity -- unit_id, unit_name and location -- is deliberately absent: it is written here by the pairing flow (core/setup_api.py) once the unit is installed and named. unit_id is derived per-device on first boot so units flashed from one image stay distinct. See vortex_profile.example.json for a configured unit.",
  "configured": false,
  "theme": "dark-river",
  "capabilities": {
    "audio": true,
    "display": true,
    "intercom": true,
    "home_assistant": true,
    "camera": false,
    "light_sensor": false,
    "presence_sensor": false
  },
  "hardware": {
    "screen": "10-inch-touchscreen",
    "screen_width": 1280,
    "screen_height": 800,
    "mic_array": "respeaker-4mic-hat",
    "speakers": "usb-stereo-5w",
    "platform": "raspberry-pi-5",
    "screen_shape": "rectangular"
  },
  "audio": {
    "wake_word": "hey_jarvis",
    "volume": 70,
    "audio_device_index": -1,
    "wake_word_threshold": 0.5
  },
  "display": {
    "screen_brightness": 80,
    "ambient_mode_enabled": true,
    "ambient_timeout": 300,
    "screen_rotation": 0
  },
  "intercom": {
    "intercom_enabled": true,
    "intercom_port": 5005
  },
  "privacy": {
    "privacy_mic_mute_on_startup": false,
    "privacy_cam_mute_on_startup": false
  },
  "backend": {
    "backend_host": "127.0.0.1",
    "backend_port": 8080
  },
  "logging": {
    "log_level": "INFO",
    "log_dir": "/var/log/river-vortex"
  },
  "camera_purposes": {
    "video_calls": false,
    "motion_snapshots": false,
    "presence": false,
    "face_recognition": false
  }
}
