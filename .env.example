# ================================================================================
# River Vortex — Environment Configuration
#
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# Configuration priority (later sources win): built-in defaults
# (core/constants.py) -> .env -> units/vortex_profile.json -> environment
# variables. See README.md for the full Environment Variables Reference.
# ================================================================================

# ── Required ────────────────────────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token

# RIVER_SONG_API_URL / RIVER_SONG_API_KEY are normally written automatically
# by the River Song app's pairing flow (see README.md > First-Run Pairing) and
# stored in units/vortex_profile.json. Set them here only for headless/dev
# setups where you want to skip pairing entirely.
RIVER_SONG_API_URL=http://riversong.local
RIVER_SONG_API_KEY=your_river_song_key

# ── Unit identity ──────────────────────────────────────────────────────────
VORTEX_UNIT_ID=vortex-unset
VORTEX_UNIT_NAME=River Vortex
VORTEX_LOCATION=Unknown Room

# ── Audio ────────────────────────────────────────────────────────────────────
VORTEX_WAKE_WORD=vortex
VORTEX_VOLUME=70
VORTEX_MIC_ENABLED=true

# ── Display ──────────────────────────────────────────────────────────────────
VORTEX_AMBIENT_MODE=true

# ── Intercom ─────────────────────────────────────────────────────────────────
VORTEX_INTERCOM_ENABLED=true

# ── Connectivity ───────────────────────────────────────────────────────────
VORTEX_CELLULAR_ENABLED=false
CELLULAR_APN=

# ── Backend server ───────────────────────────────────────────────────────────
VORTEX_BACKEND_PORT=8080

# ── Logging ──────────────────────────────────────────────────────────────────
VORTEX_LOG_LEVEL=INFO
VORTEX_LOG_DIR=/var/log/river-vortex
